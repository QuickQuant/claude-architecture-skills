{
  "schema_version": "2.0",
  "skill": "mapcodebase",
  "skill_version": "{SKILL_VERSION}",
  "model": "{MODEL_NAME}",
  "generated_at": "{TIMESTAMP}",
  "target_dir": "{TARGET_DIR}",
  "git_hash": "{GIT_HASH}",
  "head_git_hash": "{GIT_HASH}",
  "status": "success|partial|failed",
  "mode": "full|update|focus",
  "focus": null,
  "discovery_outputs": {
    "entry_points": ".work/discovery/entry-points.md",
    "data_flow": ".work/discovery/data-flow.md",
    "control_flow": ".work/discovery/control-flow.md",
    "dependencies": ".work/discovery/dependencies.md",
    "contracts": ".work/discovery/contracts.md"
  },
  "commit_distance_from_scan": 0,
  "dirty_worktree": false,
  "changed_files_since_scan": [],
  "changed_components_since_scan": [],
  "changed_boundary_contracts_since_scan": [],
  "freshness_status": "fresh|caution|stale",
  "freshness": {
    "map_git_hash": "{GIT_HASH}"
  },
  "compact_manifest": "manifest.md",
  "trust_notes": [
    "Fresh = current HEAD with no relevant drift",
    "Caution = current docs exist but git/worktree drift touches mapped areas",
    "Stale = regenerate with /mapcodebase before treating docs as authoritative"
  ],
  "access_paths": {
    "general_primer": {
      "entrypoint": "primer.md",
      "fallback_docs": ["INDEX.md", "overview.md"]
    },
    "actionable_concerns": {
      "entrypoint": "concerns.md",
      "selection_rule": "Read when deciding what to fix first, what architecture debt matters most, or what to validate with downstream review tools"
    },
    "plan_evaluation": {
      "base_docs": ["primer.md", "INDEX.md"],
      "escalation_docs": ["concerns.md", "structured/cross-references.md", "structured/components/{component-slug}.md"],
      "selection_rule": "Match plan file paths, module names, and keywords against components[].key_files and components[].intent_tags"
    },
    "component_deep_dive": {
      "base_docs": ["primer.md", "overview.md"],
      "component_doc_glob": "structured/components/*.md",
      "component_doc_paths_source": "components[].doc_path",
      "flow_doc": "structured/flows.md",
      "selection_rule": "Select generated and tracked component paths only from components[].doc_path. Enumerate component_doc_glob only for an exact-set integrity check; never infer active membership from it. Any expected/actual mismatch is non-success. Retain unknown extras for explicit future reconciliation; never silently delete them. Read the selected component doc first, then query the Current Flow Index only if the task crosses component boundaries"
    },
    "targeted_manifest": {
      "entrypoint": "manifest.md",
      "selection_rule": "Use the bundled architecture_access.py manifest-section command to load one named registry; do not load full manifest.json merely to obtain one array"
    }
  },
  "components": [
    {
      "id": "{component-slug}",
      "name": "{Component Name}",
      "purpose": "{one-line}",
      "entry_file": "{file}:{line}",
      "key_files": ["{file1}", "{file2}"],
      "doc_path": "structured/components/{component-slug}.md",
      "intent_tags": ["{tag1}", "{tag2}"],
      "runtime_status": "implemented|partial|disabled",
      "architecture_status": "active_primary|active_fallback|legacy_active|target_only|deprecated",
      "active_consumers": ["{page-or-route}", "{service}"],
      "legacy_consumers": ["{legacy-caller}"]
    }
  ],
  "metrics": {
    "files_scanned": 0,
    "components_identified": 0,
