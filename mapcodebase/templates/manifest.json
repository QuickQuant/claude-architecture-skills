      "last_checked_git": "{GIT_HASH}",
      "status": "open|resolved|not_modeled",
      "resolution": null,
      "next_action": "{concrete verification TODO}"
    }
  ],
  "answerability_tests": [
    {
      "question": "{realistic agent question, e.g. what does absent field X mean at boundary Y?}",
      "expected_docs": ["structured/components/{component-slug}.md"],
      "answer_status": "answered|unanswered",
      "evidence_refs": ["{file}:{line}"],
      "unanswered_reason": null
